---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import '../styles/cookie-consent.css';
import { createDefaultConsentConfig } from '../defaultConfig.js';
import type { CookieConsentRuntimeOptions, GoogleConsentModeOptions, SerializableCookieConsentConfig } from '../types';

interface Props {
  config?: SerializableCookieConsentConfig;
  googleConsentMode?: boolean | GoogleConsentModeOptions;
  rootId?: string;
}

const {
  config = createDefaultConsentConfig({ privacyPolicyUrl: '/privacy-policy/' }),
  googleConsentMode = false,
  rootId = 'dc-cookie-consent-root',
} = Astro.props;

const options: CookieConsentRuntimeOptions = {
  config: {
    ...config,
    root: `#${rootId}`,
  },
  googleConsentMode,
  rootSelector: `#${rootId}`,
};

const serializedOptions = JSON.stringify(options).replaceAll('<', '\\u003c');
---

<div id={rootId} transition:persist transition:name="dc-cookie-consent"></div>
<script type="application/json" data-dc-cookie-consent-options set:html={serializedOptions}></script>
<script>
  import { initializeCookieConsentFromDocument } from '../client/index.js';

  initializeCookieConsentFromDocument();
</script>
