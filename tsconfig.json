{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2021"
  },
  "include": ["src/**/*.ts", "src/**/*.astro", "src/**/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
